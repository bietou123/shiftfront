{
  "name": "shiftfront",
  "version": "0.2.1",
  "private": true,
  "description": "Original offline workplace-themed MOBA for Android",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "bundle": "esbuild src/scene3d.js --bundle --format=iife --minify --outfile=app/src/main/assets/scene3d.js",
    "smoke": "npm run bundle && node tests/smoke.cjs",
    "playability": "node tests/playability.cjs"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "playwright-core": "^1.64.1"
  }
}
